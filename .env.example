# Names only. Set a new, unique value for each one locally and never commit a real .env file.

# Root .env
# Empty by design: Docker Compose refuses to start until this value is set.
POSTGRES_PASSWORD=

# backend/.env
DATABASE_URL=
JWT_SECRET=
PORT=
NODE_ENV=
OCR_SERVICE_URL=

# backend/.env: password reset, needed only when PASSWORD_RESET_ENABLED is on
PASSWORD_RESET_ENABLED=
PASSWORD_RESET_MODE=
PASSWORD_RESET_MAIL_PROVIDER=
PASSWORD_RESET_FROM=
PUBLIC_APP_ORIGIN=
PASSWORD_RESET_ALLOWED_ORIGINS=
PASSWORD_RESET_TRUSTED_PROXIES=
PASSWORD_RESET_LIMITER_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Local password reset tests only: leave out of a normal install
# PASSWORD_RESET_POLICY=
# PASSWORD_RESET_SINK_URL=
# RESET_TEST_DATABASE=

# frontend/.env (non-dev builds; dev uses the /api proxy)
VITE_API_URL=

# ocr-service environment (optional service, each has a default in server.py)
OCR_HOST=
OCR_PORT=
OCR_THREADS=
