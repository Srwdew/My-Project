// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  passwordResetTokens PasswordResetToken[]
  role UserRole @default(USER)
  lastLoginAt DateTime?
  @@index([role, deletedAt, createdAt, id])
  anomalyPatterns AnomalyPattern[]
  anomalyIdentities AnomalyIdentity[]
  anomalyDecisions AnomalyDecision[]
  anomalyLevelShifts AnomalyLevelShift[]
  anomalyLevelShiftActions AnomalyLevelShiftAction[]
  anomalyDecisionRequests AnomalyDecisionRequest[]
  transactionCreateRequests TransactionCreateRequest[]
  setupCompletedAt          DateTime?
  setupPromptedAt           DateTime?
  anomalyReviews            AnomalyReview[]
  anomalyReviewRequests     AnomalyReviewRequest[]
  anomalySetting            AnomalyNotificationSetting?
  anomalyEvaluations        AnomalyEvaluation[]
  id                        String                      @id @default(uuid())
  email                     String                      @unique
  passwordHash              String
  createdAt                 DateTime                    @default(now())
  deletedAt                 DateTime?
  authVersion               Int                         @default(0)
  goals                     Goal[]
  goalFundingSources        GoalFundingSource[]
  goalOperations            GoalOperation[]
  goalLedgerEntries         GoalLedgerEntry[]
  goalOpeningRevisions      GoalOpeningRevision[]
  profile                   Profile?
  transactions              Transaction[]
  budgets                   Budget[]
  categoryBudgets           CategoryBudget[]
  notifications             Notification[]
  budgetNotificationSetting BudgetNotificationSetting?
  recommendationLogs        RecommendationLog[]
  categoryFlags             UserCategoryFlag[]
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  displayName   String?  @db.VarChar(80)
  occupation    String?
  income        Decimal? @db.Decimal(12, 2)
  paydayDay     Int?
  // R8: saving-rate floor the user sets (percent). Null = not set, R8 then fires only on a negative rate.
  savingRateFloorPercent Decimal? @db.Decimal(5, 2)
  primaryGoalId String?
  primaryGoal   Goal?    @relation("PrimaryGoal", fields: [userId, primaryGoalId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  avatarData    Bytes?
  avatarMime    String?  @db.VarChar(32)
  goal          String?
  lifestyle     String?

  @@index([userId, primaryGoalId])
}

enum RecommendationAction {
  followed
  dismissed
  ignored
}

// Provenance of every recommendation shown, so "how was this calculated" can be answered later.
model RecommendationLog {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id])
  ruleId          String                @db.VarChar(8)
  ruleVersion     Int
  cycleId         String                @db.VarChar(16) // Cycle.key from cycle.ts
  inputs          Json
  computed        Json
  score           Json
  citationTier    Int                   @default(1) // 1 = computed from the user's own data only
  citationRef     String?
  shownAt         DateTime              @default(now())
  userAction      RecommendationAction? // what the user pressed; null = no response yet
  outcomeVerified Boolean? // checked next cycle; null until then

  @@index([userId, cycleId])
  @@index([userId, ruleId, shownAt])
  @@map("recommendation_log")
}

// Per-user "this category can be cut" flag (Category itself is shared by every user).
// No row = fixed category; rows are never pre-created.
model UserCategoryFlag {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  flexible   Boolean
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
}

model Category {
  id              String           @id @default(uuid())
  name            String
  type            TransactionType
  transactions    Transaction[]
  categoryBudgets CategoryBudget[]
  userFlags       UserCategoryFlag[]
  anomalyLevelShifts AnomalyLevelShift[]

  createdAt DateTime @default(now())

  @@unique([name, type])
}

model Transaction {
  transactionTimeConfirmed Boolean            @default(false)
  anomalyRevision          Int                @default(0)
  anomalyPending           Boolean            @default(false)
  goalFundingSource        GoalFundingSource?
  id                       String             @id @default(uuid())
  userId                   String

  categoryId String

  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  transactionDate DateTime        @db.Date
  transactionTime DateTime?       @db.Time(0)

  paymentMethod String?
  description   String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([userId, categoryId, transactionDate])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model CategoryBudget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  year       Int
  month      Int
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, year, month, categoryId])
  @@index([categoryId])
}

enum NotificationType {
  budget_near_limit
  budget_exceeded
  transaction_anomaly
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String           @db.VarChar(160)
  message String           @db.VarChar(1000)

  // หน้าและรายการต้นทางที่เกี่ยวข้อง
  link     String? @db.VarChar(500)
  sourceId String? @db.VarChar(160)

  // ใช้ป้องกันการแจ้งเหตุการณ์เดิมซ้ำ
  eventKey String @db.VarChar(200)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model BudgetNotificationSetting {
  id              String   @id @default(uuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  warningPercent  Int      @default(80)
  notifyNearLimit Boolean  @default(false)
  notifyExceeded  Boolean  @default(false)
  totalBudget     Boolean  @default(true)
  categoryBudgets Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  income
  expense
}

enum TransactionStatus {
  planned
  completed
}

enum GoalSourceKind {
  OPENING_BALANCE
  INCOME_TRANSACTION
}

enum GoalEntryKind {
  ALLOCATE
  RELEASE
}

enum GoalOperationKind {
  CREATE_GOAL
  ALLOCATE
  RELEASE
  CORRECT_ALLOCATION
  CREATE_OPENING_BALANCE
  CORRECT_OPENING_BALANCE
}

model Goal {
  primaryProfiles      Profile[]         @relation("PrimaryGoal")
  id                   String            @id @default(uuid())
  userId               String
  name                 String            @db.VarChar(120)
  targetAmount         Decimal           @db.Decimal(12, 2)
  targetDate           DateTime?         @db.Date
  plannedMonthlyAmount Decimal?          @db.Decimal(12, 2)
  categoryKey          String            @db.VarChar(40)
  note                 String?           @db.VarChar(1000)
  archivedAt           DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries              GoalLedgerEntry[]

  @@unique([userId, id])
  @@index([userId, archivedAt, createdAt, id])
}

model GoalFundingSource {
  id                    String                @id @default(uuid())
  userId                String
  kind                  GoalSourceKind
  sourceKey             String                @db.VarChar(100)
  openingAmount         Decimal?              @db.Decimal(12, 2)
  cutoffDate            DateTime?             @db.Date
  note                  String?               @db.VarChar(1000)
  originalTransactionId String?
  transactionId         String?               @unique
  transaction           Transaction?          @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries               GoalLedgerEntry[]
  revisions             GoalOpeningRevision[]

  @@unique([userId, id])
  @@unique([userId, sourceKey])
  @@index([userId, kind])
}

model GoalOperation {
  id                  String               @id @default(uuid())
  userId              String
  idempotencyKey      String               @db.VarChar(100)
  kind                GoalOperationKind
  requestHash         String               @db.VarChar(64)
  reason              String?              @db.VarChar(1000)
  correctsOperationId String?
  correctsOperation   GoalOperation?       @relation("GoalOperationCorrection", fields: [userId, correctsOperationId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  corrections         GoalOperation[]      @relation("GoalOperationCorrection")
  responseStatus      Int
  responseBody        Json
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries             GoalLedgerEntry[]
  openingRevision     GoalOpeningRevision?

  @@unique([userId, id])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([userId, correctsOperationId])
}

model GoalLedgerEntry {
  id             String            @id @default(uuid())
  userId         String
  goalId         String
  sourceId       String
  operationId    String
  sequence       Int
  kind           GoalEntryKind
  amount         Decimal           @db.Decimal(12, 2)
  allocationId   String?
  sourceSnapshot Json
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goal           Goal              @relation(fields: [userId, goalId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  source         GoalFundingSource @relation(fields: [userId, sourceId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  operation      GoalOperation     @relation(fields: [userId, operationId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  allocation     GoalLedgerEntry?  @relation("GoalLotReleases", fields: [userId, goalId, sourceId, allocationId], references: [userId, goalId, sourceId, id], onDelete: Restrict, onUpdate: Restrict)
  releases       GoalLedgerEntry[] @relation("GoalLotReleases")

  @@unique([userId, goalId, sourceId, id])
  @@unique([operationId, sequence])
  @@index([userId, goalId, createdAt, id])
  @@index([userId, sourceId, kind])
  @@index([userId, goalId, sourceId, allocationId])
}

model GoalOpeningRevision {
  id               String            @id @default(uuid())
  userId           String
  sourceId         String
  operationId      String            @unique
  beforeAmount     Decimal?          @db.Decimal(12, 2)
  afterAmount      Decimal           @db.Decimal(12, 2)
  beforeCutoffDate DateTime?         @db.Date
  afterCutoffDate  DateTime          @db.Date
  beforeNote       String?           @db.VarChar(1000)
  afterNote        String            @db.VarChar(1000)
  reason           String            @db.VarChar(1000)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  source           GoalFundingSource @relation(fields: [userId, sourceId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  operation        GoalOperation     @relation(fields: [userId, operationId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, operationId])
  @@index([userId, sourceId, createdAt, id])
}

model AnomalyNotificationSetting {
  userId    String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AnomalyEvaluation {
  decisions AnomalyDecision[]
  reviews               AnomalyReview[]
  id                    String          @id @default(uuid())
  userId                String
  originalTransactionId String
  revision              Int
  ruleVersion           String          @db.VarChar(100)
  evaluatedAt           DateTime        @default(now()) @db.Timestamptz(3)
  outcome               String          @db.VarChar(32)
  snapshot              Json
  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, id, revision])
  @@unique([userId, originalTransactionId, revision, ruleVersion], map: "anomaly_evaluation_revision_key")
  @@index([userId, originalTransactionId, revision])
}

model AnomalyReview {
  id                    String                 @id @default(uuid())
  userId                String
  evaluationId          String
  originalTransactionId String
  revision              Int
  action                String                 @db.VarChar(32)
  sequence              Int
  reviewedAt            DateTime               @default(now()) @db.Timestamptz(3)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evaluation            AnomalyEvaluation      @relation(fields: [userId, evaluationId, revision], references: [userId, id, revision], onDelete: Restrict, onUpdate: Restrict)
  requests              AnomalyReviewRequest[]

  @@unique([userId, id])
  @@unique([userId, originalTransactionId, revision, sequence])
}

model AnomalyReviewRequest {
  userId             String
  idempotencyKey     String        @db.Uuid
  requestFingerprint String        @db.VarChar(64)
  reviewId           String
  responseStatus     Int
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  review             AnomalyReview @relation(fields: [userId, reviewId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, idempotencyKey])
  @@index([userId, reviewId])
}

model TransactionCreateRequest {
  userId String
  idempotencyKey String
  requestFingerprint String
  responseStatus Int
  responseBody Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([userId, idempotencyKey])
}

model AnomalyIdentity {
 userId String
 transactionId String
 recordedAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 revisions AnomalyRevision[]
 @@id([userId,transactionId])
}
model AnomalyRevision {
 userId String
 transactionId String
 revision Int
 snapshot Json
 provenance String
 recordedAt DateTime @default(now()) @db.Timestamptz(3)
 identity AnomalyIdentity @relation(fields:[userId,transactionId],references:[userId,transactionId],onDelete:Restrict,onUpdate:Restrict)
 @@id([userId,transactionId,revision])
}
model AnomalyDecision {
 patternId String?
 pattern AnomalyPattern? @relation(fields:[userId,patternId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 levelShiftId String?
 levelShift AnomalyLevelShift? @relation(fields:[userId,levelShiftId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 id String @id @default(uuid())
 userId String
 evaluationId String
 originalTransactionId String
 revision Int
 dimension String
 action String
 sequence Int
 supersedesId String?
 decidedAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 evaluation AnomalyEvaluation @relation(fields:[userId,evaluationId,revision],references:[userId,id,revision],onDelete:Restrict,onUpdate:Restrict)
 supersedes AnomalyDecision? @relation("DecisionSupersession",fields:[userId,supersedesId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 successors AnomalyDecision[] @relation("DecisionSupersession")
 requests AnomalyDecisionRequest[]
 @@unique([userId,id])
 @@unique([userId,originalTransactionId,revision,dimension,sequence])
}
model AnomalyDecisionRequest {
 userId String
 idempotencyKey String @db.Uuid
 fingerprint String @db.VarChar(64)
 decisionId String
 status Int
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 decision AnomalyDecision @relation(fields:[userId,decisionId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 @@id([userId,idempotencyKey])
}

// ISSUE-ANOM-1: a category's amount level moved for good. The detection is immutable; what the user said about it
// is an append-only chain (sequence/supersedes, like AnomalyDecision). No action yet = waiting for the user.
model AnomalyLevelShift {
 id String @id @default(uuid())
 userId String
 categoryId String
 direction String @db.VarChar(8)
 startDate DateTime @db.Date
 ruleVersion String @db.VarChar(100)
 evidence Json
 detectedAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 actions AnomalyLevelShiftAction[]
 decisions AnomalyDecision[]
 @@unique([userId,id])
 @@index([userId,categoryId,direction])
}
model AnomalyLevelShiftAction {
 id String @id @default(uuid())
 userId String
 levelShiftId String
 action String @db.VarChar(16)
 sequence Int
 supersedesId String?
 decidedAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 levelShift AnomalyLevelShift @relation(fields:[userId,levelShiftId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 supersedes AnomalyLevelShiftAction? @relation("LevelShiftActionSupersession",fields:[userId,supersedesId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 successors AnomalyLevelShiftAction[] @relation("LevelShiftActionSupersession")
 @@unique([userId,id])
 @@unique([userId,levelShiftId,sequence])
}
model AnomalyPattern {
 id String @id @default(uuid())
 userId String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 events AnomalyPatternEvent[]
 decisions AnomalyDecision[]
 @@unique([userId,id])
}
model AnomalyPatternEvent {
 id String @id @default(uuid())
 userId String
 patternId String
 sequence Int
 supersedesId String? @unique
 kind String
 snapshot Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 pattern AnomalyPattern @relation(fields:[userId,patternId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 supersedes AnomalyPatternEvent? @relation("PatternSupersession",fields:[userId,supersedesId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 successors AnomalyPatternEvent[] @relation("PatternSupersession")
 requests AnomalyPatternRequest[]
 @@unique([userId,id])
 @@unique([userId,patternId,sequence])
}
model AnomalyPatternRequest {
 userId String
 idempotencyKey String @db.Uuid
 fingerprint String @db.VarChar(64)
 eventId String
 event AnomalyPatternEvent @relation(fields:[userId,eventId],references:[userId,id],onDelete:Restrict,onUpdate:Restrict)
 @@id([userId,idempotencyKey])
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade, onUpdate:Cascade)
  tokenHash String @unique
  authVersionAtIssue Int
  createdAt DateTime @default(now()) @db.Timestamp(3)
  expiresAt DateTime @db.Timestamp(3)
  usedAt DateTime? @db.Timestamp(3)
  revokedAt DateTime? @db.Timestamp(3)
  @@index([userId, expiresAt])
}

model PasswordResetRateLimit {
  scope String
  subjectHash String
  windowStart DateTime @db.Timestamp(3)
  hits Int
  expiresAt DateTime @db.Timestamp(3)
  @@id([scope, subjectHash, windowStart])
  @@index([expiresAt])
}
